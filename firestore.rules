rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /rooms/{roomId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.hostUid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostUid;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
